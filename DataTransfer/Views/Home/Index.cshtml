@model CountriesViewModel
@{
    ViewData["Title"] = "Olympics Countries";
}
<div class="row">
    <div class="col-sm-3">
        <h3 class="mt-3">Games</h3>
        <div class="list-group">
            <!-- active category -->
            @foreach (string game in Model.Games)
            {
                <a asp-action="Index"
                   asp-route-activeGame="@game"
                   asp-route-activeCategory="@Model.ActiveCategory"
                   class="list-group-item @Model.CheckActiveGame(game)">
                    @game
                </a>
            }
        </div>
        <h3 class="mt-3">Categories</h3>
        <div class="list-group">
            <!-- active game -->
            @foreach (string category in Model.Categories)
            {
                <a asp-action="Index"
                   asp-route-activeGame="@Model.ActiveGame"
                   asp-route-activeCategory="@category"
                   class="list-group-item @Model.CheckActiveCategory(category)">
                    @category
                </a>
            }
        </div>
    </div>
    <div class="col-sm-9">
        <ul class="list-inline">
            @foreach (Country country in Model.Countries)
            {
                <li class="list-inline-item">
                    <a asp-action="Details" asp-route-id="@country.Name">
                        <img src="~/content/@country.LogoName" alt="@country.Name"
                             title="@country.Name | @country.Game @country.SportAndType"/>
                    </a>
                </li>
            }
        </ul>
    </div>
</div>